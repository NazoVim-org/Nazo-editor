# Auto-detect text files and normalize line endings
* text=auto

# Rust source
*.rs text diff=rust
*.toml text
*.lock text -diff

# Markdown docs
*.md text diff=markdown

# Shell scripts
*.sh text eol=lf
*.fish text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated / vendored
Cargo.lock text -diff
